# ------------------------------------------------------------------
# Comanda — Variáveis de ambiente
# Copie este arquivo para ".env" e ajuste os valores conforme o ambiente.
# ------------------------------------------------------------------

# String de conexão do PostgreSQL. Obrigatória — a aplicação não sobe sem ela.
#
# Dev local (veja docker-compose.yml — "docker compose up -d db"):
DATABASE_URL=postgresql://c---:c---@localhost:5432/-----
# Provedores gerenciados (Railway, Render, Supabase, Neon...) fornecem essa
# variável automaticamente ao provisionar o banco — normalmente não é preciso
# preencher manualmente em produção.

# Controla SSL na conexão com o banco:
#   (não definida) -> desliga SSL para localhost/127.0.0.1, liga para o resto
#   "true"  -> força SSL (necessário na maioria dos provedores gerenciados)
#   "false" -> força desligado
# DATABASE_SSL=true

# Máximo de conexões simultâneas no pool (padrão: 10)
# DATABASE_POOL_MAX=10

# URL base pública da aplicação (usada para gerar os links dos QR Codes das mesas)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Ambiente de execução
NODE_ENV=development
